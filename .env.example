PORT=3000
PUBLIC_BASE_URL=https://touchstone.jefflin.ai

# Google OAuth Web application client.
# Google Cloud Console redirect URI:
# https://touchstone.jefflin.ai/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict the connected local runner to its owner account(s).
TOUCHSTONE_RUNNER_OWNER_EMAILS=owner@example.com
TOUCHSTONE_RUNNER_LABEL=Owner Mac

# Require browser-side RSA-OAEP encryption for provider credentials.
TOUCHSTONE_REQUIRE_ENCRYPTED_CREDENTIALS=1

# Allow the authenticated runner owner to install curated local skills.
TOUCHSTONE_ALLOW_SKILL_INSTALL=1

# Optional: improves automatic project naming.
ANTHROPIC_API_KEY=
