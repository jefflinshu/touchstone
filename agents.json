{
  "agents": [
    {
      "id": "claude",
      "name": "Claude Code",
      "color": "#d97b4f",
      "command": "claude",
      "protocol": "cli-stream-json",
      "args": ["-p", "--dangerously-skip-permissions", "--input-format", "stream-json", "--output-format", "stream-json", "--include-partial-messages", "--verbose"],
      "inputFormat": "claude-stream-json",
      "modelFlag": "--model",
      "models": ["claude-fable-5", "claude-opus-4-8", "sonnet", "haiku"],
      "install": {
        "cmd": "npm install -g @anthropic-ai/claude-code",
        "doc": "https://claude.com/claude-code"
      },
      "auth": {
        "files": ["~/.claude.json"],
        "env": ["ANTHROPIC_API_KEY"],
        "loginHint": "终端运行 claude 并完成 /login 登录"
      }
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "color": "#7ee2a8",
      "command": "codex",
      "protocol": "cli-jsonl",
      "preferredProtocol": "codex-app-server",
      "args": ["exec", "--sandbox", "workspace-write", "--skip-git-repo-check", "--json", "{{PROMPT}}"],
      "modelFlag": "-m",
      "models": ["gpt-5.6-sol", "gpt-5.5", "gpt-5.5-codex", "gpt-5.1-codex-max"],
      "modelRequirements": {
        "gpt-5.6-sol": {
          "minimumVersion": "0.143.0"
        }
      },
      "install": {
        "cmd": "npm install -g @openai/codex",
        "doc": "https://developers.openai.com/codex/cli"
      },
      "auth": {
        "files": ["~/.codex/auth.json"],
        "loginHint": "终端运行 codex login 完成登录"
      }
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "color": "#6ea8ff",
      "command": "gemini",
      "protocol": "cli-stream-json",
      "args": ["-p", "{{PROMPT}}", "--yolo", "--output-format", "stream-json"],
      "inputFormat": "gemini-stream-json",
      "modelFlag": "-m",
      "models": ["gemini-3.1-pro", "gemini-3-flash", "gemini-2.5-pro"],
      "install": {
        "cmd": "npm install -g @google/gemini-cli",
        "doc": "https://github.com/google-gemini/gemini-cli"
      },
      "auth": {
        "files": ["~/.gemini/oauth_creds.json"],
        "env": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
        "loginHint": "终端运行 gemini 完成 Google 账号授权（浏览器登录一次即可）"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "color": "#f3f4f6",
      "command": "opencode",
      "protocol": "cli-jsonl",
      "preferredProtocol": "acp",
      "args": ["run", "--format", "json", "--dangerously-skip-permissions", "{{PROMPT}}"],
      "modelFlag": "-m",
      "models": [],
      "modelsCommand": ["models"],
      "modelsRequired": true,
      "install": {
        "cmd": "curl -fsSL https://opencode.ai/install | bash",
        "doc": "https://opencode.ai/docs/"
      },
      "auth": {
        "files": ["~/.local/share/opencode/auth.json"],
        "env": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GOOGLE_GENERATIVE_AI_API_KEY"],
        "loginHint": "终端运行 opencode auth login 并配置至少一个 provider"
      }
    }
  ],
  "defaults": {
    "timeoutMinutes": 20,
    "git": { "autoCommit": true, "autoPush": true },
    "autoArtifactHint": true,
    "artifactHint": "请在当前工作目录生成最终静态作品，可以包含 HTML/CSS/JS/图片/字体/音频/模型等相对路径资源；必须包含一个可以直接在浏览器中打开运行的 HTML 入口，优先命名为 index.html。所有资源必须位于当前目录内并使用相对路径，不要依赖网络 CDN、localhost 服务、密钥或父目录文件。完成后确保入口 HTML 打开即可看到效果。",
    "singleHtmlArtifactHint": "请把最终作品交付为当前工作目录中的一个自包含 index.html。CSS 和 JavaScript 必须内联；小型图片、字体或其他必要资源应尽量使用 data URL 内嵌。不要创建需要构建步骤才能运行的源码项目，不要依赖其他网站、网络 CDN、localhost 服务、密钥或父目录文件。直接双击打开 index.html 时，核心内容与交互必须可用。"
  }
}
