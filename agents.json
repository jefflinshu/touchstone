{
  "agents": [
    {
      "id": "claude",
      "name": "Claude Code",
      "color": "#d97b4f",
      "command": "claude",
      "args": ["-p", "{{PROMPT}}", "--dangerously-skip-permissions"],
      "modelFlag": "--model",
      "models": ["claude-fable-5", "claude-opus-4-8", "sonnet", "haiku"]
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "color": "#7ee2a8",
      "command": "codex",
      "args": ["exec", "--full-auto", "--skip-git-repo-check", "{{PROMPT}}"],
      "modelFlag": "-m",
      "models": ["gpt-5.5", "gpt-5.5-codex", "gpt-5.1-codex-max"]
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "color": "#6ea8ff",
      "command": "gemini",
      "args": ["-p", "{{PROMPT}}", "--yolo"],
      "modelFlag": "-m",
      "models": ["gemini-3.1-pro", "gemini-3-flash", "gemini-2.5-pro"]
    }
  ],
  "defaults": {
    "timeoutMinutes": 20,
    "git": { "autoCommit": true, "autoPush": true },
    "autoArtifactHint": true,
    "artifactHint": "\n\n【交付要求】请在当前工作目录（不要新建子目录作为入口）生成最终成果，必须包含一个可以直接在浏览器中打开运行的 index.html 作为作品入口，所有依赖（CSS/JS）内联或使用相对路径本地文件，不要依赖网络 CDN。完成后确保 index.html 打开即可看到效果。"
  }
}
