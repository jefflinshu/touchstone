      "createdAtISO": "2026-06-23T20:31:20+00:00",
      "media": [
        {
          "type": "video",
          "url": "https://video.twimg.com/amplify_video/2069517553131556864/vid/avc1/1280x720/_U4Zo503DHKGHA7D.mp4?tag=28",
          "width": 1280,
