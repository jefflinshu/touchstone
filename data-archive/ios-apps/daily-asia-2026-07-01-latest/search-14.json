    {
      "id": "2072193968872525974",
      "text": "Stop dealing with clunky web workarounds or messaging yourself links just because you carry an Android and work on a Mac. Vianta Connect bridges the gap with a lightweight, local connection that respects your privacy. The macOS client is live on the App Store today! The Android app is finishing a mandatory 14-day closed test before public launch. DM your email to get immediate beta access. 🔌",
      "author": {
        "id": "1650859481784545280",
        "name": "Astrolabs",
        "screenName": "astrolabs21",
        "profileImageUrl": "https://pbs.twimg.com/profile_images/1970051136389603328/GzDU_N5a_normal.jpg",
        "verified": true
      },
      "metrics": {
