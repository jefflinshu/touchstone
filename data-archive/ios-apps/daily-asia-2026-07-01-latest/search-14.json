    {
      "id": "2072193894692110367",
      "text": "A massive milestone: Vianta Connect macOS is officially approved and live on the App Store! 🎉 Now for the final hurdle—the Android companion app is tracking through Google’s mandatory 14-day closed testing window before public production approval. Want to bypass the waitlist, link your devices today, and help shape the final release? DM your email for a closed beta invite.",
      "author": {
        "id": "1650859481784545280",
        "name": "Astrolabs",
        "screenName": "astrolabs21",
        "profileImageUrl": "https://pbs.twimg.com/profile_images/1970051136389603328/GzDU_N5a_normal.jpg",
        "verified": true
      },
      "metrics": {
        "likes": 2,
        "retweets": 0,
        "replies": 1,
        "quotes": 0,
        "views": 46,
        "bookmarks": 0
      },
      "createdAt": "Wed Jul 01 05:41:38 +0000 2026",
      "createdAtLocal": "2026-07-01 13:41",
      "createdAtISO": "2026-07-01T05:41:38+00:00",
      "media": [],
      "urls": [],
